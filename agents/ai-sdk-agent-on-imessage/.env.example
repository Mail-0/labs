KEIKI_API_KEY=
# Full public HTTPS endpoint, including /keiki/turn.
HARNESS_URL=https://your-server.example/keiki/turn
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
AGENT_NAME=AI SDK on iMessage
PORT=3000
# Optional: for a self-hosted Keiki platform.
# KEIKI_PLATFORM_URL=http://localhost:8080
# Recommended for production: the agent ID printed by bun run sync.
# KEIKI_AGENT_ID=
# Recommended for production: generate an external harness signing secret in the dashboard.
# The handler reads it automatically and accepts only dispatches signed for that agent.
# KEIKI_SIGNING_SECRET=
