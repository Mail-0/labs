# Required: org-wide Keiki API key with agent/config/tools/secrets write access.
KEIKI_API_KEY=

# Everything below is optional.
AGENT_NAME=labs-whatsapp-restaurant-host
RESTAURANT_NAME=Example Restaurant
RESTAURANT_TIMEZONE=America/New_York
# Same-day hours. Omitted days are closed; no ranges, split shifts or overnight hours.
# Example: mon closed;tue 17:00-22:00;wed 17:00-22:00;thu 17:00-22:00;fri 17:00-23:00;sat 17:00-23:00
OPENING_HOURS=daily 17:00-22:00
SEAT_CAPACITY=30
SLOT_MINUTES=90
MAX_PARTY_SIZE=8
KEIKI_PLATFORM_URL=https://onkeiki.com
